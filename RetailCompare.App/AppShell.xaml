<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:app="clr-namespace:RetailCompare.App"
       xmlns:views="clr-namespace:RetailCompare.App.Views"
       x:Class="RetailCompare.App.AppShell">

    <TabBar>
        <Tab Title="Products">
            <ShellContent ContentTemplate="{DataTemplate app:MainPage}" />
        </Tab>
        <Tab Title="Watchlist">
            <ShellContent ContentTemplate="{DataTemplate views:WatchlistPage}" />
        </Tab>
    </TabBar>

</Shell>