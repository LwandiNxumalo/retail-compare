<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RetailCompare.App.ViewModels"
             xmlns:models="clr-namespace:RetailCompare.Shared.models;assembly=RetailCompare.Shared"
             x:Class="RetailCompare.App.MainPage"
             x:DataType="vm:MainPageViewModel"
             Title="RetailCompare">

    <Grid RowDefinitions="Auto, *">
        <!-- Search Bar Header -->
        <Border Grid.Row="0"
                BackgroundColor="#1E293B"
                Padding="12,8">
            <Border BackgroundColor="#334155"
                    StrokeShape="RoundRectangle 8"
                    Padding="6">
                <SearchBar Placeholder="Search products or categories..."
                           Text="{Binding SearchText, Mode=TwoWay}"
                           SearchCommand="{Binding SearchProductsCommand}"
                           PlaceholderColor="#94A3B8"
                           TextColor="White"
                           BackgroundColor="Transparent" />
            </Border>
        </Border>

        <!-- Pull to Refresh List -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadProductsCommand}">
            <Grid>
                <!-- Empty State Message -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="8">
                    <Label Text="No products found."
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#64748B" />
                    <Label Text="Try adjusting your search terms."
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="#94A3B8" />
                </VerticalStackLayout>

                <!-- Product Collection -->
                <CollectionView ItemsSource="{Binding Products}"
                                SelectionMode="None"
                                Margin="16,10">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProductDto">
                            <Border Margin="0,0,0,12"
                                    Padding="16"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#E2E8F0"
                                    BackgroundColor="White">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainPageViewModel}}, Path=SelectProductCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                    <!-- Category Tag -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Category}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#2563EB" />

                                    <!-- Product Name -->
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A"
                                           Margin="0,4,0,0" />

                                    <!-- Price -->
                                    <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                           Text="{Binding CurrentLowestPrice, StringFormat='R{0:F2}'}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#16A34A"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>
    </Grid>
</ContentPage>