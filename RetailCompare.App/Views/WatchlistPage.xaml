<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RetailCompare.Shared.models;assembly=RetailCompare.Shared"
             xmlns:vm="clr-namespace:RetailCompare.App.ViewModels"
             x:Class="RetailCompare.App.Views.WatchlistPage"
             x:DataType="vm:WatchlistViewModel"
             Title="My Watchlist">

    <Grid RowDefinitions="Auto,*">

        <!-- Header Banner -->
        <Border Grid.Row="0"
                BackgroundColor="#1E293B"
                Padding="16,12"
                Margin="0,0,0,10">
            <Label Text="Your Tracked Watchlist"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="16"
                   HorizontalOptions="Center" />
        </Border>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadWatchlistCommand}">

            <Grid>
                <!-- Empty State Message -->
                <Label Text="Your watchlist is empty."
                       IsVisible="{Binding IsEmpty}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="16"
                       TextColor="#64748B" />

                <!-- Watchlist Items List -->
                <CollectionView ItemsSource="{Binding WatchlistItems}"
                                Margin="16,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:WatchlistItemDto">
                            <Border Margin="0,0,0,12"
                                    Padding="16"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#E2E8F0"
                                    BackgroundColor="White">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                                    <!-- Product Name -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding ProductName}"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           TextColor="#0F172A" />

                                    <!-- Target vs Current Price -->
                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0"
                                                           Spacing="10"
                                                           Margin="0,6,0,0">
                                        <Label Text="{Binding CurrentPrice, StringFormat='Current: R{0:F2}'}"
                                               FontSize="14"
                                               TextColor="#64748B" />
                                        <Label Text="{Binding TargetPrice, StringFormat='Target: R{0:F2}'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#16A34A" />
                                    </HorizontalStackLayout>

                                    <!-- Remove Button -->
                                    <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                            Text="Remove"
                                            BackgroundColor="#EF4444"
                                            TextColor="White"
                                            CornerRadius="6"
                                            FontSize="12"
                                            HeightRequest="36"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WatchlistViewModel}}, Path=RemoveItemCommand}"
                                            CommandParameter="{Binding .}"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>
    </Grid>
</ContentPage>