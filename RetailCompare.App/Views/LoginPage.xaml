<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:RetailCompare.App.ViewModels"
             x:Class="RetailCompare.App.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Sign In"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid VerticalOptions="Center" Padding="24">
        <VerticalStackLayout Spacing="16" MaximumWidthRequest="400">

            <Label Text="RetailCompare"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#2563EB"
                   HorizontalOptions="Center" />

            <Label Text="Welcome back! Please sign in to continue."
                   FontSize="14"
                   TextColor="#64748B"
                   HorizontalOptions="Center"
                   Margin="0,0,0,16" />

            <!-- Dynamic Error Message Banner -->
            <Border BackgroundColor="#FEE2E2"
                    Stroke="#FCA5A5"
                    Padding="12"
                    StrokeShape="RoundRectangle 6"
                    IsEnabled="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#DC2626"
                       FontSize="13" />
            </Border>

            <!-- Email Entry -->
            <Entry Placeholder="Email Address"
                   Text="{Binding Email}"
                   Keyboard="Email"
                   IsSpellCheckEnabled="True"
                   IsTextPredictionEnabled="True"
                   ClearButtonVisibility="WhileEditing" />

            <!-- Password Entry -->
            <Entry Placeholder="Password"
                   Text="{Binding Password}"
                   IsPassword="True"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False" />

            <!-- Remember Me & Forgot Password -->
            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <CheckBox IsChecked="{Binding RememberMe}" />
                    <Label Text="Remember Me" VerticalOptions="Center" TextColor="#64748B" FontSize="13" />
                </HorizontalStackLayout>

                <Button Grid.Column="1"
                        Text="Forgot Password?"
                        Command="{Binding ForgotPasswordCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#2563EB"
                        FontSize="13"
                        Padding="0" />
            </Grid>

            <!-- Login Button -->
            <Button Text="Sign In"
                    Command="{Binding LoginCommand}"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="48"
                    Margin="0,8,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#2563EB"
                               HorizontalOptions="Center" />

            <!-- Register Navigation Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,16,0,0">
                <Label Text="Don't have an account?" TextColor="#64748B" VerticalOptions="Center" />
                <Button Text="Sign Up"
                        Command="{Binding GoToRegisterCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#2563EB"
                        FontAttributes="Bold" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </Grid>

</ContentPage>